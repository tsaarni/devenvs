{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "Debug Quarkus (keycloak-junit5)",
            "request": "launch",
            "mainClass": "org.keycloak.Keycloak",
            "projectName": "keycloak-junit5",

            "args": "start-dev --verbose",

            // All configuration options:
            // - https://www.keycloak.org/server/all-config
            "env": {
                "KC_HOSTNAME": "keycloak.127.0.0.1.nip.io",
                "KC_BOOTSTRAP_ADMIN_USERNAME": "admin",
                "KC_BOOTSTRAP_ADMIN_PASSWORD": "admin",
                "KC_DB_URL": "jdbc:h2:./quarkus/dist/target/keycloakdb;NON_KEYWORDS=VALUE;AUTO_SERVER=TRUE",
                //"KC_DB_URL": "jdbc:h2:file:${workspaceFolder}/quarkus/dist/target/keycloakdb;NON_KEYWORDS=VALUE;AUTO_SERVER=TRUE",

                // UI development
                // Uncomment following, remove KC_HOSTNAME
                //"KC_ADMIN_VITE_URL": "http://localhost:5174",
                // then run UI under Vite
                // (cd js; pnpm --filter keycloak-admin-ui run dev)
            },
        },
        {
            "type": "java",
            "name": "Debug Quarkus with mirrord / Kubernetes (keycloak-junit5)",
            "request": "launch",
            "mainClass": "org.keycloak.Keycloak",
            "projectName": "keycloak-junit5",

            "args": "start-dev --verbose",

            "env": {
                "KC_BOOTSTRAP_ADMIN_USERNAME": "admin",
                "KC_BOOTSTRAP_ADMIN_PASSWORD": "admin",
                "KC_DB": "postgres",
                "KC_DB_URL": "jdbc:postgresql://postgres/keycloak?sslmode=disable",
                "KC_DB_USERNAME": "keycloak",
                "KC_DB_PASSWORD": "keycloak",
                "MIRRORD_ACTIVE": "1",
                "MIRRORD_CONFIG_FILE": "/home/tsaarni/work/devenvs/keycloak/configs/mirrord.toml",
            },
        },
        {
            "type": "java",
            "name": "Import realm",
            "request": "launch",
            "mainClass": "org.keycloak.quarkus._private.IDELauncher",
            "projectName": "keycloak-quarkus-server-app",
            "args": "import --dir /home/tsaarni/work/devenvs/keycloak/migrations/ldap-federation-simple/",
        },
        {
            "type": "java",
            "name": "Debug (Attach 5005 Quarkus port)",
            "request": "attach",
            "hostName": "localhost",
            "port": 5005
        },
        {
            "type": "java",
            "name": "Debug (Attach 8000)",
            "request": "attach",
            "hostName": "localhost",
            "port": 8000
        },
        {
            "type": "java",
            "name": "Debug (Launch) - Current File",
            "request": "launch",
            "mainClass": "${file}"
        },
    ]
}
