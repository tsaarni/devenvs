{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run dev server",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}",
            "args": ["server", "-dev", "-dev-root-token-id=root", "-log-level=debug"],
            "env": {
                "SSLKEYLOGFILE": "${workspaceFolder}/wireshark-keys.log",
                "KUBERNETES_SERVICE_HOST": "localhost",
                "KUBERNETES_SERVICE_PORT": "16443"
            }
        },
        {
            "name": "Run with file backend",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}",
            "args": ["server", "-config=${env:HOME}/work/devenvs/openbao/configs/openbao-file-backend.hcl", "-log-level=debug"],
        }
    ]
}
